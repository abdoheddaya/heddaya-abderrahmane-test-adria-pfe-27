type Account {
    id: ID!
    customerReference: String!
    status: String!
    currency: String!
    balance: String!
}

type Query {
    accounts: [Account!]!
    account(id: ID!): Account
}

type Mutation {
    createAccount(
        customerReference: String!
        currency: String!
        initialBalance: String!
    ): Account!
}