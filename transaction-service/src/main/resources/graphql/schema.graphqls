type BankTransaction {
    id: ID!
    accountId: ID!
    amount: String!
    currency: String!
    merchantCategory: String!
    country: String!
    createdAt: String!
}

type Query {
    transactions: [BankTransaction!]!
    transactionsByAccount(accountId: ID!): [BankTransaction!]!
}

type Mutation {
    createTransaction(
        accountId: ID!
        amount: String!
        currency: String!
        merchantCategory: String!
        country: String!
    ): BankTransaction!
}